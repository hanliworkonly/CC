<div class="container" style="margin-top: 2rem;">
  <h2 style="margin-bottom: 2rem;">仪表盘</h2>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
    <div class="card">
      <h3 style="color: #3498db; margin-bottom: 0.5rem;">总用户数</h3>
      <p style="font-size: 2rem; font-weight: bold;" id="total-users">-</p>
    </div>

    <div class="card">
      <h3 style="color: #2ecc71; margin-bottom: 0.5rem;">活跃用户</h3>
      <p style="font-size: 2rem; font-weight: bold;" id="active-users">-</p>
    </div>

    <div class="card">
      <h3 style="color: #e74c3c; margin-bottom: 0.5rem;">管理员</h3>
      <p style="font-size: 2rem; font-weight: bold;" id="admin-users">-</p>
    </div>
  </div>

  <div class="card" style="margin-top: 2rem;">
    <h3 style="margin-bottom: 1rem;">欢迎使用 Phoenix 后台管理系统</h3>
    <p>这是一个基于 Phoenix Framework 和 JWT 认证的后台管理系统。</p>
    <br>
    <h4>主要功能：</h4>
    <ul style="margin-left: 2rem; margin-top: 0.5rem;">
      <li>基于 JWT 的用户认证</li>
      <li>用户管理（增删改查）</li>
      <li>角色权限控制</li>
      <li>RESTful API 接口</li>
    </ul>
  </div>
</div>

<script>
  async function loadDashboardData() {
    const token = localStorage.getItem('token');

    try {
      const response = await fetch('/api/users', {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (response.ok) {
        const data = await response.json();
        const users = data.users;

        document.getElementById('total-users').textContent = users.length;
        document.getElementById('active-users').textContent =
          users.filter(u => u.is_active).length;
        document.getElementById('admin-users').textContent =
          users.filter(u => u.role === 'admin').length;
      } else if (response.status === 401) {
        localStorage.removeItem('token');
        window.location.href = '/login';
      }
    } catch (error) {
      console.error('Failed to load dashboard data:', error);
    }
  }

  loadDashboardData();
</script>
